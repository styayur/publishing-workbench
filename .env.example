# Documentation only: the app intentionally does not load .env secrets.
# Enter real credentials in Extensions; secrets are saved in the OS credential store.
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=editor
WORDPRESS_APPLICATION_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
GENERIC_REST_ENDPOINT=https://example.com/articles
GENERIC_REST_BEARER_TOKEN=

# Optional isolated local profile (credentials still use OS keyring).
# WORKBENCH_DATA_DIR=C:/workbench-data
