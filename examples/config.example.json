  "generic-rest": {
    "endpoint": "https://example.com/articles",
    "method": "POST",
    "template": "{\"title\":\"{{title}}\",\"content\":\"{{html}}\",\"tags\":\"{{tags}}\",\"status\":\"{{action}}\"}",
