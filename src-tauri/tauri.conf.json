{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Publishing Workbench",
  "version": "0.2.0",
  "identifier": "dev.styayur.publishing-workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Publishing Workbench",
        "width": 1240,
        "height": 850,
        "minWidth": 850,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
